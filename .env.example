# Copy to .env to customize local Docker settings.
# The fallback values in docker-compose.yml also allow a local demo to start without this file.
POSTGRES_DB=admission
POSTGRES_USER=admission_app
POSTGRES_PASSWORD=local-dev-only-change-me
HOLD_DURATION_SECONDS=600
API_BASE_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:3000
